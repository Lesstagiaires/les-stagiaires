# Base de données
DATABASE_URL="postgresql://stagiaires:stagiaires@localhost:5432/stagiaires?schema=public"

# Cache & files d'attente
REDIS_URL="redis://localhost:6379"

# Auth
JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me"
JWT_REFRESH_EXPIRES_IN="30d"

# OTP
OTP_TTL_MINUTES="5"
OTP_MAX_ATTEMPTS="5"

# Verrouillage de compte après tentatives infructueuses
LOCKOUT_MAX_ATTEMPTS="5"
LOCKOUT_DURATION_MINUTES="15"

# LS-ID
LS_ID_COUNTRY_CODE="CM"

# Consentement parental actif (CLAUDE.md §5, FR-AUTH-004a/b/c)
PARENTAL_CONSENT_TTL_HOURS="72"
PARENTAL_CONSENT_FLAG_AFTER_DAYS="30"

# SMS — "console" (dev) ou "africastalking" (prod)
SMS_PROVIDER="console"

# Stockage documents de profil — "local" (dev) ou "r2" (prod)
STORAGE_PROVIDER="local"

# Documents de profil (FR-PRO-004)
DOCUMENT_ENCRYPTION_KEY="change-me-64-hex-chars"
DOCUMENT_MAX_SIZE_MB="10"
DOCUMENT_ALLOWED_MIME_TYPES="image/jpeg,image/png,application/pdf"
DOCUMENT_RETENTION_DAYS="7"

# Analyse anti-malware (CLAUDE.md §4) — "dev" (aucune analyse, accepte tout — jamais en
# production) ou "clamav" (démon clamd réel, requis avant tout déploiement recevant de
# vrais fichiers utilisateur). CLAMAV_HOST/PORT pointent vers le conteneur clamd du
# docker-compose local ; à adapter en production.
MALWARE_SCANNER_PROVIDER="dev"
CLAMAV_HOST="localhost"
CLAMAV_PORT="3310"
CLAMAV_TIMEOUT_MS="15000"

# Digital Safe (module 3, FR-M3-008)
APP_PUBLIC_URL="http://localhost:3000"
DIGITAL_SAFE_SHARE_MAX_DAYS="30"

# Opportunités (module 4, FR-M4-013)
OPPORTUNITY_DEFAULT_DURATION_DAYS="60"
OPPORTUNITY_ARCHIVE_AFTER_DAYS="90"

# Candidatures (module 5) — accord parental de déplacement (mineur, offre à relocalisation)
TRAVEL_CONSENT_TTL_DAYS="7"

# Sécurité HTTP (CLAUDE.md §8 — durcissement pré-prod)
# TRUST_PROXY="true" uniquement en production derrière un reverse proxy/CDN unique
# (ex. Cloudflare) — sinon le rate-limiting (ThrottlerGuard) peut être neutralisé.
TRUST_PROXY="false"
# Origines autorisées en CORS, séparées par des virgules — vide par défaut (aucune
# origine autorisée). L'app mobile n'en a pas besoin ; à renseigner seulement quand
# un client web appelle l'API directement, ex. "https://app.les-stagiaires.africa".
CORS_ALLOWED_ORIGINS=""

# À renseigner au fur et à mesure des modules (jamais de vraie valeur ici, ni en clair ailleurs) :
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_USERNAME=
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET=
# SENTRY_DSN=
