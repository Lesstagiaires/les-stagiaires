# Base de données
DATABASE_URL="postgresql://stagiaires:stagiaires@localhost:5432/stagiaires?schema=public"

# Cache & files d'attente
REDIS_URL="redis://localhost:6379"

# Auth
JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me"
JWT_REFRESH_EXPIRES_IN="30d"

# OTP
OTP_TTL_MINUTES="5"
OTP_MAX_ATTEMPTS="5"

# Verrouillage de compte après tentatives infructueuses
LOCKOUT_MAX_ATTEMPTS="5"
LOCKOUT_DURATION_MINUTES="15"

# LS-ID
LS_ID_COUNTRY_CODE="CM"

# Consentement parental actif (CLAUDE.md §5, FR-AUTH-004a/b/c)
PARENTAL_CONSENT_TTL_HOURS="72"
PARENTAL_CONSENT_FLAG_AFTER_DAYS="30"

# SMS — "console" (dev) ou "africastalking" (prod)
SMS_PROVIDER="console"

# Stockage documents de profil — "local" (dev) ou "r2" (prod)
STORAGE_PROVIDER="local"

# Documents de profil (FR-PRO-004)
DOCUMENT_ENCRYPTION_KEY="change-me-64-hex-chars"
DOCUMENT_MAX_SIZE_MB="10"
DOCUMENT_ALLOWED_MIME_TYPES="image/jpeg,image/png,application/pdf"
DOCUMENT_RETENTION_DAYS="7"

# Digital Safe (module 3, FR-M3-008)
APP_PUBLIC_URL="http://localhost:3000"
DIGITAL_SAFE_SHARE_MAX_DAYS="30"

# Opportunités (module 4, FR-M4-013)
OPPORTUNITY_DEFAULT_DURATION_DAYS="60"
OPPORTUNITY_ARCHIVE_AFTER_DAYS="90"

# Candidatures (module 5) — accord parental de déplacement (mineur, offre à relocalisation)
TRAVEL_CONSENT_TTL_DAYS="7"

# À renseigner au fur et à mesure des modules (jamais de vraie valeur ici, ni en clair ailleurs) :
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_USERNAME=
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET=
# SENTRY_DSN=
