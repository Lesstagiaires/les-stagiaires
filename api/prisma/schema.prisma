// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Language {
  FR
  EN
}

enum AccountStatus {
  PENDING_VERIFICATION
  // Mineur en "mode restreint" (CLAUDE.md §5) : téléphone vérifié, compte pleinement
  // explorable (profil, brouillons) dès l'inscription — jamais bloqué en attendant le
  // parent. Seules les actions transactionnelles (candidature réelle, signature de
  // convention, partage Digital Safe) resteront conditionnées à ce statut, une fois ces
  // modules construits. Passe à ACTIVE dès que le parent/tuteur consent activement.
  AWAITING_PARENTAL_CONSENT
  ACTIVE
  DEACTIVATED
  PENDING_DELETION
  DELETED
}

enum OtpPurpose {
  REGISTRATION
  LOGIN_2FA
  PASSWORD_RESET
}

enum ParentalLinkStatus {
  PENDING
  ACTIVE
  REVOKED
  // Consentement jamais obtenu au-delà du délai (CLAUDE.md §5 : signalement puis suspension à 30 jours).
  EXPIRED
}

model User {
  id       String  @id @default(cuid())
  lsId     String? @unique
  email    String? @unique
  phone    String? @unique
  password String

  language Language      @default(FR)
  status   AccountStatus @default(PENDING_VERIFICATION)

  isMinor     Boolean   @default(false)
  dateOfBirth DateTime?

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  twoFactorEnabled Boolean @default(false)

  deactivatedAt       DateTime?
  deletionScheduledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles               UserRole[]
  otpCodes            OtpCode[]
  refreshTokens       RefreshToken[]
  parentLinksAsChild  ParentalLink[] @relation("ChildLinks")
  parentLinksAsParent ParentalLink[] @relation("ParentLinks")
  auditLogs           AuditLog[]
  reports             Report[]

  @@index([email])
  @@index([phone])
}

model Role {
  id              String  @id @default(cuid())
  name            String  @unique
  description     String?
  // Un rôle non "selfAssignable" (ex: ADMIN) ne peut jamais être attribué par l'utilisateur
  // lui-même — uniquement via une procédure interne, conformément à CLAUDE.md §3.
  selfAssignable  Boolean @default(false)

  permissions RolePermission[]
  userRoles   UserRole[]
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  id         String    @id @default(cuid())
  userId     String
  roleId     String
  isActive   Boolean   @default(true)
  assignedAt DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ParentalLink {
  id      String @id @default(cuid())
  childId String
  // Le téléphone déclaré par le mineur est la source de vérité de la demande — le parent
  // n'a pas besoin d'un compte existant sur la plateforme pour consentir (CLAUDE.md §5 :
  // limite assumée du MVP, numéro déclaratif non vérifié par pièce d'identité).
  parentPhone String
  // Rattaché a posteriori si un compte existe déjà ou est créé avec ce numéro — jamais requis.
  parentId String?

  status ParentalLinkStatus @default(PENDING)

  // Code de consentement envoyé par SMS au parent — propre à la demande, pas au compte
  // parent (qui peut ne pas exister), hashé comme tout secret (CLAUDE.md §2/§6).
  consentCodeHash    String?
  consentExpiresAt   DateTime?
  consentAttempts    Int       @default(0)
  maxConsentAttempts Int       @default(5)

  // Horodatage du signalement automatique à 30 jours sans réponse (CLAUDE.md §5).
  flaggedAt DateTime?

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  child  User  @relation("ChildLinks", fields: [childId], references: [id], onDelete: Cascade)
  parent User? @relation("ParentLinks", fields: [parentId], references: [id], onDelete: SetNull)

  @@unique([childId, parentPhone])
  @@index([status, createdAt])
}

model OtpCode {
  id          String     @id @default(cuid())
  userId      String
  codeHash    String
  purpose     OtpPurpose
  destination String
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ReportCategory {
  HARASSMENT
  ABUSE
  DANGER
  FRAUD
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWED
  CLOSED
}

// Mécanisme de signalement minimal (CLAUDE.md §5 : non négociable dès le MVP, même sous
// une forme simple — harcèlement, abus, danger).
model Report {
  id          String         @id @default(cuid())
  reporterId  String
  category    ReportCategory
  description String
  status      ReportStatus   @default(OPEN)
  createdAt   DateTime       @default(now())

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
}
