node_modules
dist

# Stockage local de dev pour les documents (jamais de fichier utilisateur en dépôt)
storage-data/

# ---------------------------------------------------------------------------
# VARIABLES D'ENVIRONNEMENT — TOUTE LA FAMILLE, SAUF L'EXEMPLE
#
# Le motif est volontairement large. Énumérer les variantes (.env.local,
# .env.production, .env.development.local…) revient à parier qu'on pensera à
# ajouter la prochaine — et le jour où on l'oublie, ce sont des identifiants de
# production qui partent au dépôt. Ici, tout ce qui commence par .env est exclu
# par défaut, et seul .env.example est réintroduit explicitement.
# ---------------------------------------------------------------------------
.env*
!.env.example


/generated/prisma
backups/

# Worktrees créés par les agents — espace de travail, jamais du code du projet
.claude/worktrees/

# Sortie d'exécution de la recette : un journal daté, qui périme aussitôt écrit
recette-resultat.txt
